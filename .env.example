# ---------------------------------------------------------------------------
# Voice-to-Calendar — environment variables (T-03, T-31)
# Copy to .env for local development. In production these live only in
# Railway variables — never in the repository.
# ---------------------------------------------------------------------------

# --- Infrastructure --------------------------------------------------------
# Injected automatically by the Railway Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voicecal
ENVIRONMENT=development
# Stable HTTPS origin. Must match the custom domain exactly (T-32).
PUBLIC_BASE_URL=https://scheduler.example.com

# --- Encryption ------------------------------------------------------------
# Generate with: python -m app.jobs.setup_webhook fernet
FERNET_KEY=

# --- Google ----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered verbatim in the Google Cloud console.
GOOGLE_REDIRECT_URI=https://scheduler.example.com/auth/google/callback
# Opaque token echoed back in X-Goog-Channel-Token on push notifications.
GOOGLE_WEBHOOK_TOKEN=

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Sent as X-Telegram-Bot-Api-Secret-Token and validated on every request.
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated allow-list. EMPTY MEANS NOBODY — the bot fails closed.
TELEGRAM_ALLOWED_USER_IDS=

# --- Models ----------------------------------------------------------------
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
ANTHROPIC_API_KEY=
EXTRACTION_PROVIDER=anthropic
EXTRACTION_MODEL=claude-sonnet-5
OPENAI_EXTRACTION_MODEL=gpt-4o-2024-11-20

# --- Behaviour -------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Yerevan
DEFAULT_DURATION_MINUTES=60
MAX_AUDIO_SECONDS=120
AUDIO_RETENTION_DAYS=30
AUDIO_STORAGE_DIR=/tmp/voice-calendar-audio
PENDING_CARD_TTL_MINUTES=60
COMMANDS_PER_HOUR=30
SLOW_PIPELINE_NOTICE_SECONDS=15

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
# Never enable in production: transcripts are business-sensitive.
LOG_TRANSCRIPTS=false
